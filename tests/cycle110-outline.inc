void FomawriteTest::outlineKeyboardFilteringAndCancelPreserveSourceSelection() {
    Cycle103SettingsSnapshot isolatedSettings;
    Backend backend;
    QQmlEngine engine; engine.rootContext()->setContextProperty("backend", &backend);
    QQmlComponent component(&engine, QUrl(QStringLiteral("qrc:/Main.qml")));
    QScopedPointer<QObject> window(component.create()); QVERIFY2(window, qPrintable(component.errorString()));
    auto *quick = qobject_cast<QQuickWindow *>(window.data());
    auto *editor = window->findChild<QQuickItem *>("sourceEditor");
    auto *outline = window->findChild<QObject *>("documentOutline");
    auto *search = window->findChild<QQuickItem *>("documentOutlineSearch");
    auto *list = window->findChild<QQuickItem *>("documentOutlineList");
    auto *clear = window->findChild<QQuickItem *>("documentOutlineClearSearch");
    auto *empty = window->findChild<QQuickItem *>("documentOutlineEmptyState");
    auto *commands = window->findChild<QObject *>("workspaceCommands");
    QVERIFY(quick && editor && outline && search && list && clear && empty && commands);
    cycle106KeepNativeFocus(quick);
    Cycle106MouseInputIsolation mouseInput(quick);
    quick->resize(1200, 760); quick->show();
    QVERIFY(QTest::qWaitForWindowExposed(quick));
    if (QGuiApplication::platformName() != "cocoa") {
        quick->requestActivate(); QTRY_VERIFY(quick->isActive());
    }
    const QString draft = QString::fromUtf8("## Introduction\n\nOpening.\n\n### Café section\n\nPreserve this selection.\n\n#### Detail\n\nDetails.\n\n## Closing\n\nEnd.\n");
    editor->setProperty("text", draft);
    const auto cleanup = qScopeGuard([&] { backend.discardRecovery(); });
    QVERIFY(QMetaObject::invokeMethod(window.data(), "selectWritingMode", Q_ARG(QVariant, "source")));
    QTRY_VERIFY(!window->property("changingDocumentView").toBool());
    const int start = draft.indexOf("Preserve this selection");
    QVERIFY(QMetaObject::invokeMethod(editor, "select", Q_ARG(int, start), Q_ARG(int, start + 13)));
    editor->forceActiveFocus();
    const int cursor = editor->property("cursorPosition").toInt();
    const int revision = backend.documentRevision();
    QSignalSpy jumped(outline, SIGNAL(jumpRequested(int)));
    QVERIFY(QMetaObject::invokeMethod(commands, "run", Q_ARG(QVariant, "outline")));
    QTRY_VERIFY(outline->property("opened").toBool());
    QTRY_VERIFY(search->hasActiveFocus());
    QCOMPARE(list->property("count").toInt(), 4);
    QCOMPARE(outline->property("currentHeadingPosition").toInt(), draft.indexOf(QString::fromUtf8("### Café section")));
    QCOMPARE(outline->property("minimumHeadingLevel").toInt(), 2);
    QTRY_COMPARE(list->property("currentIndex").toInt(), 1);
    cycle111KeyClick(quick, Qt::Key_Down);
    QCOMPARE(list->property("currentIndex").toInt(), 2);
    cycle111KeyClick(quick, Qt::Key_Up);
    QCOMPARE(list->property("currentIndex").toInt(), 1);
    list->forceActiveFocus();
    cycle111KeyClick(quick, Qt::Key_End);
    QCOMPARE(list->property("currentIndex").toInt(), 3);
    cycle111KeyClick(quick, Qt::Key_Home);
    QCOMPARE(list->property("currentIndex").toInt(), 0);
    search->forceActiveFocus();
    search->setProperty("text", "No such heading");
    QTRY_COMPARE(list->property("count").toInt(), 0);
    QVERIFY(empty->isVisible());
    QVERIFY(empty->property("text").toString().contains("No headings match"));
    cycle111KeyClick(quick, Qt::Key_Return);
    QVERIFY(outline->property("opened").toBool());
    QCOMPARE(jumped.count(), 0);
    QVERIFY(cycle102Click(quick, clear));
    QTRY_COMPARE(list->property("count").toInt(), 4);
    QVERIFY(search->hasActiveFocus());
    search->setProperty("text", QString::fromUtf8("CAFÉ"));
    QTRY_COMPARE(list->property("count").toInt(), 1);
    cycle111KeyClick(quick, Qt::Key_Escape);
    QTRY_VERIFY(!outline->property("opened").toBool());
    QTRY_VERIFY(editor->hasActiveFocus());
    QCOMPARE(jumped.count(), 0);
    QCOMPARE(editor->property("cursorPosition").toInt(), cursor);
    QCOMPARE(editor->property("selectionStart").toInt(), start);
    QCOMPARE(editor->property("selectionEnd").toInt(), start + 13);
    QCOMPARE(editor->property("text").toString(), draft);
    QCOMPARE(backend.documentRevision(), revision);
    // The next opening starts unfiltered at the source's current section.
    QVERIFY(QMetaObject::invokeMethod(commands, "run", Q_ARG(QVariant, "outline")));
    QTRY_VERIFY(outline->property("opened").toBool());
    QCOMPARE(search->property("text").toString(), QString());
    QTRY_COMPARE(list->property("currentIndex").toInt(), 1);
    QVERIFY(QMetaObject::invokeMethod(outline, "close"));
    QTRY_VERIFY(!outline->property("opened").toBool());
    // An empty document has useful feedback and no accidental jump on Return.
    editor->setProperty("text", QStringLiteral("A paragraph without headings."));
    QVERIFY(QMetaObject::invokeMethod(commands, "run", Q_ARG(QVariant, "outline")));
    QTRY_VERIFY(outline->property("opened").toBool());
    QCOMPARE(list->property("count").toInt(), 0);
    QVERIFY(empty->property("text").toString().contains("Add Markdown headings"));
    cycle111KeyClick(quick, Qt::Key_Return);
    QVERIFY(outline->property("opened").toBool());
    QCOMPARE(jumped.count(), 0);
    QVERIFY(QMetaObject::invokeMethod(outline, "close"));
}
