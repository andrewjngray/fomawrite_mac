# Maintainer: Andrew Gray
# Based on the upstream Omawrite package by David Heinemeier Hansson.

pkgname=fomawrite
pkgver=0.1.0
pkgrel=1
pkgdesc='Local Markdown writing app built with Qt Quick'
arch=('x86_64')
url='https://github.com/andrewjngray/fomawrite_mac'
license=('MIT')
install='fomawrite.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/fomawrite "$pkgdir/usr/bin/fomawrite"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/fomawrite.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/fomawrite.svg"
  /usr/bin/install -Dm644 "$startdir/fomawrite.desktop" "$pkgdir/usr/share/applications/fomawrite.desktop"
}
