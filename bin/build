#!/usr/bin/env sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
. "$ROOT/bin/qt-env"
mkdir -p "$ROOT/build"
cd "$ROOT/build"
"$QMAKE" "$ROOT/omawrite.pro"
make -j"$JOBS"
if [ "$(uname -s)" = Darwin ]; then
  echo "Built $ROOT/build/Omawrite.app"
else
  echo "Built $ROOT/build/omawrite"
fi
