#!/usr/bin/env sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
. "$ROOT/bin/qt-env"
mkdir -p "$ROOT/build"
cd "$ROOT/build"
"$QMAKE" "$ROOT/fomawrite.pro"
# qmake emits the bundle plist target without a dependency on our source plist.
# Regenerate it explicitly so incremental builds carry the current version.
if [ "$(uname -s)" = Darwin ]; then
  make -B Fomawrite.app/Contents/Info.plist
fi
make -j"$JOBS"
if [ "$(uname -s)" = Darwin ]; then
  mkdir -p "$ROOT/build/Fomawrite.app/Contents/Resources/licenses"
  cp "$ROOT/LICENSE" "$ROOT/build/Fomawrite.app/Contents/Resources/licenses/Upstream-Omawrite-MIT.txt"
  cp "$ROOT/fonts/OFL.txt" "$ROOT/build/Fomawrite.app/Contents/Resources/licenses/Fonts-OFL.txt"
  cp "$ROOT/src/vendor/md4c/LICENSE.md" "$ROOT/build/Fomawrite.app/Contents/Resources/licenses/MD4C-MIT.txt"
  echo "Built $ROOT/build/Fomawrite.app"
else
  echo "Built $ROOT/build/fomawrite"
fi
