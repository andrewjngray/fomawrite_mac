#!/usr/bin/env sh
# Build and archive committed source with a verifiable manifest.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"
TAG="${1:?Usage: bin/archive-mac-release mac-vVERSION}"
case "$TAG" in *[!A-Za-z0-9._-]*|'') echo 'Invalid release name' >&2; exit 1;; esac
# User documents can be dirty; compiled inputs must match the commit.
git diff --quiet HEAD -- src fomawrite.pro macos bin fonts LICENSE || { echo 'Commit compiled inputs before archiving.' >&2; exit 1; }
"$ROOT/bin/package-mac"
APP="$ROOT/dist/Fomawrite.app"
codesign --verify --deep --strict "$APP"
ARCH="$(uname -m)"
OUTPUT="$ROOT/dist/releases/$TAG"
[ ! -e "$OUTPUT" ] || { echo 'Archive already exists; choose a new release name.' >&2; exit 1; }
mkdir -p "$OUTPUT"
ARCHIVE="Fomawrite-Mac-$ARCH.zip"
ditto -c -k --sequesterRsrc --keepParent "$APP" "$OUTPUT/$ARCHIVE"
{
    echo "Fomawrite Mac $TAG"
    echo "Source: $(git rev-parse HEAD)"
    echo "Architecture: $ARCH"
    echo "macOS build host: $(sw_vers -productVersion)"
    echo 'Minimum macOS: 14.0. Local ad-hoc signature; not notarized.'
    echo 'Build: ./bin/build; ./bin/test; ./bin/package-mac'
    echo 'Archive: ./bin/archive-mac-release TAG'
    echo 'Reproducible procedure; timestamps/signatures are not bit-for-bit reproducible.'
} > "$OUTPUT/BUILD-INFO.txt"
(cd "$OUTPUT" && shasum -a 256 "$ARCHIVE" BUILD-INFO.txt > SHA256SUMS.txt)
printf 'Archived %s\n' "$OUTPUT"
